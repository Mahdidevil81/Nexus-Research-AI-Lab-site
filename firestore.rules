rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Validation for Feedback Entity
    function isValidFeedback(data) {
      return data.keys().hasAll(['messageId', 'feedback', 'timestamp', 'userId']) &&
             data.keys().size() == 4 &&
             data.messageId is string && data.messageId.size() <= 128 &&
             (data.feedback == 'up' || data.feedback == 'down') &&
             data.timestamp is number &&
             data.userId == request.auth.uid;
    }

    match /feedback/{feedbackId} {
      // Users can only read their own feedback
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      
      // Users can only create their own feedback
      allow create: if isSignedIn() && isValidId(feedbackId) && isValidFeedback(incoming());
      
      // Feedback can be updated, but userId and messageId cannot change
      allow update: if isSignedIn() && isValidFeedback(incoming()) && 
                    existing().userId == request.auth.uid &&
                    incoming().userId == existing().userId &&
                    incoming().messageId == existing().messageId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['feedback', 'timestamp']);
    }
  }
}
